# ── Copy this file to ".env" on the server and fill in real values. ──
# ".env" is gitignored and must NEVER be committed.

# ---- Server ----
PORT=5093

# ---- SQL Server (the new 2023-DT1 box) ----
DB_SERVER=2023-DT1
DB_PORT=1433
DB_DATABASE=SmartDeskApp
DB_USER=smartapp_user
DB_PASSWORD=__set_this_on_the_server__

# ---- Outlook / Office365 SMTP (set-password link emails) ----
# Use smtp.office365.com for M365 business tenants.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=itservicedesk@smartworlddevelopers.com
SMTP_PASS=__set_this_on_the_server__
SMTP_FROM=itservicedesk@smartworlddevelopers.com

# ---- Where the portal is reachable from a browser (used to build the set-password link) ----
APP_BASE_URL=http://swdsales.com:92

# ---- File Converter (Word/PowerPoint/Excel ↔ PDF) ----
# Needs LibreOffice installed on this server (free): https://www.libreoffice.org/download/
# Only set SOFFICE_PATH if it is NOT in C:\Program Files\LibreOffice\program\soffice.exe
# SOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
# Max size per file for server-side conversions (MB)
CONVERT_MAX_MB=25

# ---- SmartDesk AI search (Claude) ----
# Create a key at https://platform.claude.com → API keys. Keep it only in .env (never in the frontend).
ANTHROPIC_API_KEY=
# Optional: model and effort (defaults: claude-sonnet-5-5, low = fastest answers)
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_EFFORT=low
# Where backend-attendance runs (for "who is in office" questions)
# ATTENDANCE_API_URL=http://localhost:5092/api
